ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=          # audition at play.cartesia.ai; defaults to "British Reading Lady"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=              # E.164, e.g. +14155550123
LOCAL_SERVER_URL=           # ngrok https URL, no trailing slash
MEMBER_PHONE=               # Dolores (P3's phone), E.164
FAMILY_PHONE=               # Susan (P2's phone), E.164
ROBERT_PHONE=               # optional; falls back to MEMBER_PHONE
NESSIE_KEY=
NESSIE_TXN_ROUTE=purchases  # set to withdrawals if /accounts/{id}/purchases 404s
CRS_USERNAME=
CRS_PASSWORD=""             # quote it: an unquoted # truncates the value
CONVEX_URL=                 # https://<name>.convex.cloud
CONVEX_WRITE_SECRET=        # same value as `npx convex env set CASE_WRITE_SECRET ...`
APIFY_TOKEN=                # optional: pull alerts from our actor's last run (else alerts.json)
APIFY_ACTOR=                # e.g. <username>/ftc-scam-alerts
ELASTIC_URL=                # optional: history + scam-pattern search
ELASTIC_API_KEY=
FACTORY_API_KEY=            # optional: morning review (needs the `droid` CLI on PATH)
STT=                        # empty = Cartesia Ink (default); "deepgram" = fallback
SHIELD_NUMBER=              # optional: Dolores's protected line (a 2nd Twilio number), Scam Shield
